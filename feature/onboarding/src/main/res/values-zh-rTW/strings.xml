    <string name="onboarding_back">返回</string>
    <string name="onboarding_welcome_title">歡迎使用 LibreLookAI</string>
    <string name="onboarding_welcome_body">為你既有衣櫥打造的 AI 造型師。拍下你的衣物、取得穿搭靈感、試穿，並為旅行打包——全部私密地保存在你自己的 Google 雲端硬碟。</string>
    <string name="onboarding_wardrobe_title">你的數位衣櫥</string>
    <string name="onboarding_wardrobe_body">每件單品只需拍攝一次。AI 會移除背景並標記類型、顏色、材質等，讓一切都能搜尋。</string>
    <string name="onboarding_outfits_title">AI 穿搭靈感</string>
    <string name="onboarding_outfits_body">取得依天氣、場合與你品味量身打造的穿搭建議——僅以你實際擁有的衣物組成。</string>
    <string name="onboarding_tryon_title">在自己身上試穿</string>
    <string name="onboarding_tryon_body">加入你的照片，穿上之前就能在自己身上看到任何穿搭。隨時點按中央按鈕即可開始試穿。</string>
    <string name="onboarding_travel_title">為任何旅程打包</string>
    <string name="onboarding_travel_body">告訴旅行規劃工具你要去哪裡、去多久。它會從你的衣櫃逐日打造膠囊衣櫥。</string>
    <string name="onboarding_shopping_title">更聰明的購物</string>
    <string name="onboarding_shopping_body">儲存你正在考慮的單品，讓購物小幫手檢查它們是否與你既有的衣物相搭——並填補真正的缺口。</string>
    <string name="onboarding_profile_title">告訴我們你的風格</string>
    <string name="onboarding_profile_body">這能幫助 AI 為你量身調整每項建議。你可以隨時在設定中變更。</string>
    <string name="onboarding_photo_title">加入試穿照片</string>
    <string name="onboarding_photo_body">正面全身照能讓你在自己身上試穿。可選——之後也能再加入。</string>
    <string name="onboarding_photo_add">加入照片</string>
    <string name="onboarding_photo_added">已加入照片</string>
    <string name="onboarding_photo_offline">請連上網路以加入你的照片。</string>
    <string name="onboarding_closet_title">建立你的衣櫃</string>
    <string name="onboarding_closet_body">你的第一個衣櫃已就緒。加入幾件衣物即可取得第一批穿搭靈感——或先逛逛，想加入時再加入。</string>
    <string name="onboarding_closet_explore">探索應用程式</string>
    <string name="onboarding_apikey_title">新增你的 Gemini API 金鑰</string>
    <string name="onboarding_apikey_body">LibreLookAI 使用你自己的 API 金鑰在 Google Gemini 上運作。金鑰僅儲存在此裝置，並直接與 Google 使用，不會經過我們的伺服器。</string>
    <string name="onboarding_apikey_tiers">免費金鑰已足以用於標記和穿搭建議。虛擬試穿與背景移除會生成影像，因此需要已啟用帳單的付費金鑰；Google 仍只會依你的實際用量收費。</string>
    <string name="onboarding_apikey_get">取得 API 金鑰</string>
    <string name="onboarding_apikey_billing">啟用帳單（供試穿使用）</string>
    <string name="onboarding_apikey_saved">金鑰已儲存在此裝置 ✓</string>
    <string name="onboarding_apikey_offline">請連上網際網路以開啟 Google AI Studio。你仍可貼上已擁有的金鑰。</string>
    <string name="onboarding_drive_title">連接你的 Google 雲端硬碟</string>
    <string name="onboarding_drive_body">LibreLookAI 會將一切——你的衣物、穿搭與相片——都保存在你自己 Google 雲端硬碟的私人資料夾中。我們的伺服器不會儲存任何內容，只有你看得到。使用 Google 登入以建立你的衣櫥。</string>
    <string name="onboarding_drive_connect">使用 Google 登入</string>
    <string name="onboarding_drive_connected">已連接 Google 雲端硬碟 ✓</string>
    <string name="onboarding_drive_offline">請連上網際網路以使用 Google 登入。</string>
    <string name="onboarding_background_title">允許背景處理</string>
    <string name="onboarding_background_body">匯入相片、移除背景以及用 AI 為衣物加上標籤可能需要一些時間。LibreLookAI 需要不受限制的背景處理，以免 Android 在任務進行中關閉應用程式——否則可能留下匯入到一半的項目、遺漏的標籤或損毀的檔案。\n\n這僅允許應用程式完成你已開始的工作，它不會自行執行任何東西。</string>
    <string name="onboarding_background_allow">允許背景處理</string>
    <string name="onboarding_background_granted">已允許背景處理 ✓</string>
    <string name="onboarding_location_title">啟用定位以取得天氣</string>
    <string name="onboarding_location_body">LibreLookAI 會使用你的概略位置查詢當地天氣，以便推薦適合當天天候的穿搭。你的位置僅保留在裝置上，且只用於取得天氣，絕不會儲存或分享。你可以略過此步驟，稍後再啟用。</string>
    <string name="onboarding_location_allow">允許存取位置</string>
    <string name="onboarding_location_granted">已啟用定位 ✓</string>
    <string name="onboarding_finish_setup_title">你的設定</string>
    <string name="onboarding_finish_drive">Google 雲端硬碟</string>
    <string name="onboarding_finish_background">背景處理</string>
