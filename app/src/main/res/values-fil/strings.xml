    <string name="settings_dedupe_title">Pagtatsek ng pagkakatulad</string>
    <string name="settings_dedupe_desc">Tuklasin ang mga visually similar na item na nasa iyong wardrobe bago ka mag-import o mag-scan ng mga duplicate. Tumatakbo nang buong on-device gamit ang parehong model bilang Shopping helper.</string>
