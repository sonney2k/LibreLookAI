rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read their own credit balance.
    // Writing is done server-side only (Cloud Functions use Admin SDK).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Purchase records are write-once from the server; never readable by clients.
    match /purchases/{purchaseToken} {
      allow read, write: if false;
    }
  }
}
