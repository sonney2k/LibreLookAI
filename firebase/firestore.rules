rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own credit balance + ledger; never write.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // Append-only audit log of every purchase / spend / refund. Server-only
      // writes via Cloud Functions; users can read their own history.
      match /ledger/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Purchase records are write-once from the server; never readable by clients.
    match /purchases/{purchaseToken} {
      allow read, write: if false;
    }

    // /config holds two docs:
    //   - pricing:       raw costs + multiplier (server-only). The multiplier
    //                    is our markup and must never reach the client.
    //   - publicPricing: post-multiplier coin prices the client uses to render
    //                    cost badges. Mirror written by recomputePublicPricing.
    match /config/pricing {
      allow read, write: if false;
    }
    match /config/publicPricing {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
